# Vendor grammars are reference specs for Rust highlighter (CI: cargo xtask check-highlight-rust).
assets/highlightjs/*.js text eol=lf
assets/highlightjs/*.meta.json text eol=lf

# Example protos and companions are checked with `buf format --diff` in CI.
examples/proto/** text eol=lf

# Golden / highlight fixtures must match Linux CI output on Windows runners.
tests/fixtures/** text eol=lf
